# SB1 optional production integrations
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vercel server-side Stripe Connect checkout (never expose these in VITE_ variables)
STRIPE_SECRET_KEY=
STRIPE_CONNECT_ACCOUNT_ID=
SB1_PLATFORM_FEE_PERCENT=20
SB1_PUBLIC_URL=

# Web Push (optional until VAPID keys are configured)
VITE_VAPID_PUBLIC_KEY=
# Supabase Edge Function push secrets: configure in Supabase Secrets
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Server-only: required for verified wallet top-up confirmation
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Stripe webhook secret (never expose to Vite/client)
STRIPE_WEBHOOK_SECRET=
