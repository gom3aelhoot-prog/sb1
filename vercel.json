{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite",
  "buildCommand":"npm run build",
  "outputDirectory":"dist",
  "installCommand":"npm install",
  "rewrites":[
    {"source":"/api/social-search","destination":"/api/router"},
    {"source":"/api/music-search","destination":"/api/router"},
    {"source":"/api/media-library","destination":"/api/router"},
    {"source":"/api/youtube-search","destination":"/api/router"},
    {"source":"/api/health","destination":"/api/router"},
    {"source":"/api/monitor","destination":"/api/router"},
    {"source":"/:path*","destination":"/index.html"}
  ]
}