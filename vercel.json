{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/marketing/weekly-newsletter", "schedule": "0 9 * * 1" }
  ],
  "rewrites": [
    { "source": "/:path*", "destination": "/index.html" }
  ]
}