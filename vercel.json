{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/marketing/weekly-newsletter", "schedule": "0 9 * * 1" }
  ],
  "rewrites": [
    { "source": "/api/youtube-search", "destination": "/api/marketing/publish" },
    { "source": "/api/google-images", "destination": "/api/social-search?provider=google-images" },
    { "source": "/api/health", "destination": "/api/monitor" },
    { "source": "/api/wallet-confirm", "destination": "/api/wallet-checkout?action=confirm" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}